# Packaging: what `git archive` (and so Composer's dist zip) leaves out.
# Ships: src/ (Tests/ included), bin/, docs/mds/, skills.MD, README.md, LICENSE, composer.json.

# docs site: only docs/mds/ ships
/docs/*.php export-ignore
/docs/lib export-ignore
/docs/views export-ignore
/docs/assets export-ignore
/docs/data export-ignore
/docs/cache export-ignore
/docs/CLAUDE.md export-ignore

# development
/future-plans export-ignore
/phpunit.phar export-ignore
/scripts export-ignore

# agent guides for working on the framework itself
/CLAUDE.md export-ignore
/AGENTS.md export-ignore

# brand source files
/assets export-ignore

# git
/.gitattributes export-ignore
/.gitignore export-ignore
